# Copy to .env and edit. Every value has a sane default — the only one you almost
# certainly need to change is BOT_ROOT.

# ---- Bot source -----------------------------------------------------------
# A copy of the bot's engine ships in ./bot, so the default just works after clone.
# Point this at your own full Binansquare checkout to also show its live paper
# positions and pick up new signals it writes to output/signals/.
BOT_ROOT=./bot

# ---- Server ---------------------------------------------------------------
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8777

# ---- Polling cadence ----------------------------------------------------------
# Live price + 24h volume refresh (one batched Binance request for the whole watchlist).
PORTAL_PRICE_POLL_SEC=5
# Recompute indicators + engine signals per symbol. The engine works on CLOSED candles,
# so values change at most once per candle; polling faster only catches the close sooner.
PORTAL_SIGNAL_POLL_SEC=30

# ---- History / storage ------------------------------------------------------
# How often a full indicator snapshot row is written to SQLite (for sparklines/history).
PORTAL_SNAPSHOT_INTERVAL_SEC=60
# Snapshot rows older than this are pruned on startup.
PORTAL_SNAPSHOT_RETENTION_DAYS=30
# SQLite file location.
PORTAL_DB=./data/portal.db

# ---- Market data ----------------------------------------------------------
# Candle timeframe. Blank -> inherit SIGNAL_TIMEFRAME from the bot's .env (default 1h).
PORTAL_TIMEFRAME=
# Candles fetched per symbol per scan (must exceed the slowest EMA + warm-up; >= 300).
PORTAL_KLINES_LIMIT=300

# ---- Telegram (optional) --------------------------------------------------
# Push a message for every signal the portal detects. Set BOTH to enable.
# Create a bot with @BotFather for the token; message it once, then read your chat id
# from https://api.telegram.org/bot<token>/getUpdates (the "chat":{"id":...}).
# Kept separate from the bot's own TELEGRAM_* so you can use a different bot/chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Also push signals the portal picked up from the bot's own output/signals/*.txt.
# Leave false if BOT_ROOT points at a real bot that already sends its own Telegram.
PORTAL_TELEGRAM_INCLUDE_BOT=false

# ---- Live trading (optional) --------------------------------------------
# The portal can place SPOT MARKET orders through the Binance Agent OS MCP. By default
# every order is a person clicking + confirming in the UI. See docs/trading.md.
#
# "dry-run" (default): simulated fills, no network, no orders. "live": real orders.
TRADE_MODE=dry-run
# Hard kill switch. Any value except ""/0/false/no/off blocks new OPENs (CLOSE stays allowed).
KILL_SWITCH=0
# USDT spent on an OPEN (manual or auto). Cap: TRADE_MAX_NOTIONAL_USDT.
TRADE_NOTIONAL_USDT=10

# ---- Auto-execute on signals (opt-in) ---------------------------------------
# When 1: a new entry-LONG signal schedules a market BUY, an exit signal schedules a
# CLOSE of that position — each after a countdown you can cancel (top bar / Trading
# panel). Still off until you ARM it in the Trading panel. Every auto order passes the
# same guardrails. Restart after changing.
TRADE_AUTO_ON_SIGNAL=0
# Seconds to wait before an armed auto order fires (min 3, max 600).
TRADE_AUTO_DELAY_SEC=30
# Extra gate: auto only fires in TRADE_MODE=live when this is also 1.
TRADE_AUTO_ALLOW_LIVE=0

# Guardrail limits — default to the reference values; env can tighten or modestly
# raise them, up to a hard ceiling the agent cannot exceed.
TRADE_MAX_NOTIONAL_USDT=10        # ceiling 100
TRADE_MAX_ORDERS_PER_DAY=5        # ceiling 50
TRADE_DAILY_LOSS_LIMIT_USDT=10    # ceiling 1000; trips the kill switch for the UTC day
TRADE_MAX_OPEN_POSITIONS=1        # ceiling 3

# Needed only for TRADE_MODE=live. The execution agent is Claude via the Anthropic API,
# driving the OAuth-scoped Binance Agent OS MCP (spot order/query tools only).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
BINANCE_AGENT_MCP_URL=https://agent.binance.com/mcp/agentic
# OAuth access token for a Binance SUB-ACCOUNT — capture it via MCP Inspector, see docs/trading.md.
BINANCE_AGENT_OAUTH_TOKEN=
